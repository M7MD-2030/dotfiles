#!/bin/bash
# t — toggle Claude / YouTube blocks in /etc/hosts, and the waybar clock
#   t            status of everything
#   t cl         toggle Claude
#   t yt         toggle YouTube
#   t t          toggle the clock in waybar
#   t yt status  status of one
set -euo pipefail
export PATH=/usr/sbin:/usr/bin
SELF=/usr/local/bin/t

# The real user's home, even when running under sudo
REAL_USER=${SUDO_USER:-$USER}
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
TIME_FLAG="$REAL_HOME/.cache/tt-hide-time"   # waybar's status.sh watches this

show_time() { if [[ -f $TIME_FLAG ]]; then echo "Clock: HIDDEN"; else echo "Clock: SHOWN"; fi; }

# --- t t : clock toggle, runs as the normal user (no root needed) ---
if [[ ${1:-} == t || ${1:-} == time ]]; then
  if [[ ${2:-} == status || ${2:-} == s ]]; then show_time; exit 0; fi
  if [[ -f $TIME_FLAG ]]; then
    rm -f "$TIME_FLAG"; echo "Clock: SHOWN"
  else
    mkdir -p "${TIME_FLAG%/*}"; touch "$TIME_FLAG"; echo "Clock: HIDDEN"
  fi
  exit 0
fi

# --- everything else edits /etc/hosts, so re-run as root (passwordless via sudoers) ---
[[ $EUID -eq 0 ]] || exec sudo -n "$SELF" "$@"

HOSTS=/etc/hosts
CLAUDE_DOMAINS=(claude.ai www.claude.ai)   # add api.anthropic.com to also cut Claude Code
YOUTUBE_DOMAINS=(
  youtube.com www.youtube.com m.youtube.com music.youtube.com
  studio.youtube.com tv.youtube.com gaming.youtube.com youtu.be
  youtube-nocookie.com www.youtube-nocookie.com
  youtubei.googleapis.com youtube.googleapis.com
  yt3.ggpht.com ytimg.com i.ytimg.com s.ytimg.com i9.ytimg.com
  youtubekids.com www.youtubekids.com
)
declare -A LABEL=([claude]=Claude [youtube]=YouTube)

usage() { echo "usage: t [cl|yt|t] [status]" >&2; exit 1; }

target=""; action=toggle
(( $# == 0 )) && action=status
for a in "$@"; do
  case "$a" in
    cl|claude)  target=claude ;;
    yt|youtube) target=youtube ;;
    status|s)   action=status ;;
    *)          usage ;;
  esac
done

bm() { echo "# ===== ${1^^} BLOCK BEGIN ====="; }
em() { echo "# ===== ${1^^} BLOCK END ====="; }
blocked() { grep -qxF "$(bm "$1")" "$HOSTS"; }
show() { if blocked "$1"; then echo "${LABEL[$1]}: BLOCKED"; else echo "${LABEL[$1]}: ALLOWED"; fi; }

if [[ $action == status ]]; then
  if [[ -n $target ]]; then show "$target"; else show claude; show youtube; show_time; fi
  exit 0
fi
[[ -n $target ]] || usage

B=$(bm "$target"); E=$(em "$target")
declare -n DOMAINS="${target^^}_DOMAINS"

chattr -i "$HOSTS"
trap 'chattr +i "$HOSTS"' EXIT

if blocked "$target"; then
  sed -i "/^${B}\$/,/^${E}\$/d" "$HOSTS"
  echo "${LABEL[$target]}: ALLOWED"
else
  {
    echo "$B"
    for d in "${DOMAINS[@]}"; do printf '0.0.0.0 %s\n:: %s\n' "$d" "$d"; done
    echo "$E"
  } >> "$HOSTS"
  echo "${LABEL[$target]}: BLOCKED"
fi
resolvectl flush-caches 2>/dev/null || true
