{
  // ---------- no AI ----------
  "disable_ai": true,
  "show_edit_predictions": false,

  // ---------- no terminal ----------
  "terminal": { "button": false },

  // ---------- file tree hidden, still opens with Ctrl+B ----------
  "project_panel": { "dock": "left", "button": false, "default_width": 260, "auto_reveal_entries": true },

  // ---------- strip the UI ----------
  "tab_bar": { "show": false },
  "status_bar": { "experimental.show": false },
  "scrollbar": { "show": "never" },
  "toolbar": { "breadcrumbs": false, "quick_actions": false, "selections_menu": false, "code_actions": false },
  "inline_code_actions": false,
  "gutter": { "folds": false, "runnables": false, "breakpoints": false },
  "title_bar": {
    "show_branch_name": false,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_menus": false
  },
  "collaboration_panel": { "button": false },
  "notification_panel": { "button": false },
  "outline_panel": { "button": false },
  "git_panel": { "button": false },
  "debugger": { "button": false },

  // ---------- look ----------
  "theme": "Ayu Dark",
  "icon_theme": "Catppuccin Mocha",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "ui_font_size": 16,
  "soft_wrap": "editor_width",
  "show_whitespaces": "selection",
  "inlay_hints": { "enabled": true },

  // ---------- behaviour ----------
  "vim_mode": false,
  "autosave": { "after_delay": { "milliseconds": 500 } },
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "auto_update": false,
  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_install_extensions": {
    "catppuccin": true, "catppuccin-icons": true,
    "toml": true, "dockerfile": true, "ini": true, "log": true
  },
  "file_scan_exclusions": [
    "**/.git", "**/__pycache__", "**/.ipynb_checkpoints",
    "**/.pytest_cache", "**/.ruff_cache", "**/node_modules",
    "**/target", "**/vendor"
  ],

  // ---------- language intelligence + highlighting (not AI) ----------
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff", "!pylsp", "!pyright"],
      "formatter": { "language_server": { "name": "ruff" } },
      "code_actions_on_format": { "source.organizeImports.ruff": true }
    },
    "Rust": {
      "tab_size": 4
    },
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
      "code_actions_on_format": { "source.organizeImports": true }
    },
    "C++": {
      "tab_size": 4,
      "formatter": { "language_server": { "name": "clangd" } }
    },
    "C": {
      "tab_size": 4,
      "formatter": { "language_server": { "name": "clangd" } }
    },
    "Shell Script": {
      "tab_size": 4,
      "formatter": { "external": { "command": "shfmt", "arguments": ["-i", "4"] } }
    }
  },
  "lsp": {
    "basedpyright": { "settings": { "basedpyright.analysis": { "typeCheckingMode": "standard" } } },
    "rust-analyzer": { "initialization_options": { "check": { "command": "clippy" } } },
    "gopls": { "initialization_options": { "staticcheck": true } }
  }
}
