[
    {
        "context": "Editor",
        "bindings": {
            "ctrl-shift-up": "editor::DuplicateLineUp",
            "ctrl-shift-down": "editor::DuplicateLineDown",
            "ctrl-alt-up": "editor::MoveLineUp",
            "ctrl-alt-down": "editor::MoveLineDown",
            "alt-backspace": [
                "workspace::SendKeystrokes",
                "home shift-end backspace"
            ],
            "super-r": "task::Spawn",
            "alt-left": "editor::MoveToBeginningOfLine",
            "alt-right": "editor::MoveToEndOfLine",
            "alt-up": "editor::MoveToBeginning",
            "alt-down": "editor::MoveToEnd"
        }
    },
    {
        "context": "Editor",
        "unbind": {
            "ctrl-shift-k": "editor::DeleteLine"
        }
    }
]
