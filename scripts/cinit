#!/bin/bash
set -e

BASE_DIR="$HOME/Dev/C"

read -rp "Project name: " NAME
if [ -z "$NAME" ]; then
    echo "Error: project name cannot be empty."
    exit 1
fi

PROJECT_DIR="$BASE_DIR/$NAME"
if [ -d "$PROJECT_DIR" ]; then
    echo "Error: $PROJECT_DIR already exists."
    exit 1
fi

echo "Select language:"
echo "  1) C"
echo "  2) C++"
read -rp "Choice [1-2]: " LANG_CHOICE

case "$LANG_CHOICE" in
    1) LANG="c" ;;
    2) LANG="cpp" ;;
    *) echo "Invalid choice."; exit 1 ;;
esac

mkdir -p "$PROJECT_DIR/src"
mkdir -p "$PROJECT_DIR/include"
mkdir -p "$PROJECT_DIR/build"

if [ "$LANG" = "cpp" ]; then
    EXT="cpp"
    STD_LINE="set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)"
    LANG_NAME="CXX"
else
    EXT="c"
    STD_LINE="set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)"
    LANG_NAME="C"
fi

cat > "$PROJECT_DIR/CMakeLists.txt" << EOF
cmake_minimum_required(VERSION 3.20)
project($NAME LANGUAGES $LANG_NAME)

$STD_LINE

file(GLOB_RECURSE SOURCES "\${CMAKE_SOURCE_DIR}/src/*.$EXT")

add_executable(\${PROJECT_NAME} \${SOURCES})

target_include_directories(\${PROJECT_NAME} PRIVATE \${CMAKE_SOURCE_DIR}/include)

# --- Optional: uncomment to link raylib for games/multimedia ---
# find_package(raylib REQUIRED)
# target_link_libraries(\${PROJECT_NAME} raylib)
EOF

if [ "$LANG" = "cpp" ]; then
cat > "$PROJECT_DIR/src/main.cpp" << 'EOF'
#include <iostream>

int main() {
    std::cout << "Hello, forge!" << std::endl;
    return 0;
}
EOF
else
cat > "$PROJECT_DIR/src/main.c" << 'EOF'
#include <stdio.h>

int main(void) {
    printf("Hello, forge!\n");
    return 0;
}
EOF
fi

cat > "$PROJECT_DIR/.gitignore" << 'EOF'
build/
*.o
*.out
EOF

cd "$PROJECT_DIR"
git init -q

echo ""
echo "Project created at $PROJECT_DIR"
echo "Open it with: zed $PROJECT_DIR"
